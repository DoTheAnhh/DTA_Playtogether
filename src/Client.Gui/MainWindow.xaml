<Window x:Class="DTA.Client.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTA Play Together — Modern Automation Suite"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TopBar Header -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="DTA" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PLAY TOGETHER PRO" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="C# + Unity Engine" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Thiết bị: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="LDPlayer #0 (127.0.0.1:5554)" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Phiên bản: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="v227628" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ONLINE" Foreground="#4ADE80" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Sidebar + Content) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0" Padding="10,14">
                <StackPanel>
                    <RadioButton x:Name="TabBtnTeleport" GroupName="NavTabs" IsChecked="True" Click="NavTab_Click" Tag="PanelTeleport" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="📍  Dịch chuyển" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnFishing" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelFishing" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="🎣  Câu cá" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnMining" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelMining" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="⛏️  Đập đá" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnInsect" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelInsect" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="🦋  Bắt bọ" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnExcavation" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelExcavation" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="🏺  Đào cổ vật" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnFarm" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelFarm" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="🌱  Nông trại" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnCollect" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelCollect" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="📦  Thu thập" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnEsp" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelEsp" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="👁️  ESP Radar" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnSettings" GroupName="NavTabs" Click="NavTab_Click" Tag="PanelSettings" Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10" Margin="0,2">
                                    <TextBlock Text="⚙️  Cài đặt" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="20">
                <!-- ================= 1. TELEPORT PANEL ================= -->
                <Grid x:Name="PanelTeleport" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍 Quản lý Dịch chuyển &amp; Góc nhìn nhân vật" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock Text="Bắt buộc có góc nhìn (Yaw/Pitch/POV)" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Mọi thao tác teleport đồng bộ cả toạ độ XYZ, hướng quay nhân vật (Quaternion) và góc nhìn camera sau lưng" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchTeleport" TextChanged="TxtSearchTeleport_TextChanged" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10,6" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbMapFilter" SelectionChanged="CmbMapFilter_SelectionChanged" Grid.Column="1" Background="#0F172A" Foreground="Black" Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="BtnAddCurrentPos" Click="BtnAddCurrentPos_Click" Grid.Column="2" Content="+ Lưu vị trí hiện tại" Background="#334155" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Waypoints DataGrid -->
                    <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="GridWaypoints" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowBackground="#1E293B" AlternatingRowBackground="#182234" Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên vị trí" Binding="{Binding Name}" Width="190"/>
                                    <DataGridTextColumn Header="Bản đồ" Binding="{Binding MapName}" Width="120"/>
                                    <DataGridTextColumn Header="Toạ độ (X, Y, Z)" Binding="{Binding Position}" Width="170"/>
                                    <DataGridTextColumn Header="Góc nhìn (Yaw / Pitch)" Binding="{Binding Viewpoint}" Width="*"/>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="BtnExecuteTeleport" Click="BtnExecuteTeleport_Click" Content="⚡ DỊCH CHUYỂN TỚI VỊ TRÍ ĐÃ CHỌN" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13" Padding="20,10" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 2. FISHING PANEL ================= -->
                <Grid x:Name="PanelFishing" Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="🎣 Tự động Câu cá (Fishing Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Gọi trực tiếp Game Functions (quăng cần, giật cá, bán/bảo quản cá) trên Unity Main Thread" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,12"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button x:Name="BtnToggleFishing" Click="BtnToggleFishing_Click" Content="▶ BẮT ĐẦU CÂU" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="16,8" BorderThickness="0" Margin="0,0,10,0"/>
                                    <CheckBox Content="Tự sửa cần khi hết độ bền" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox Content="Cá cắn nhanh (Fast Bite)" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox Content="Khóa POV camera" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Thống kê câu cá" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0F172A" Padding="14" CornerRadius="8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Tổng cá câu được" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock x:Name="TxtFishCaught" Text="0 con" Foreground="#38BDF8" FontWeight="Bold" FontSize="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#0F172A" Padding="14" CornerRadius="8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Đã bán nhanh" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock x:Name="TxtFishSold" Text="0 con" Foreground="#4ADE80" FontWeight="Bold" FontSize="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#0F172A" Padding="14" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Độ bền cần câu" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock x:Name="TxtRodDurability" Text="100%" Foreground="#FBBF24" FontWeight="Bold" FontSize="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= 3. MINING PANEL ================= -->
                <Grid x:Name="PanelMining" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="⛏️ Tự động Đập đá &amp; Khai khoáng (Mining Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Tự động quét mạch quặng, đi bộ hoặc dịch chuyển tới nơi và thực thi OnClickPickax()" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnToggleMining" Click="BtnToggleMining_Click" Content="▶ BẮT ĐẦU ĐẬP ĐÁ" Background="#F59E0B" Foreground="Black" FontWeight="Bold" Padding="16,8" BorderThickness="0" Margin="0,0,12,0"/>
                                <TextBlock Text="Mạch đá đã khai thác: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRocksMined" Text="0" Foreground="#4ADE80" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 4. INSECT PANEL ================= -->
                <Grid x:Name="PanelInsect" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🦋 Tự động Bắt bọ (Insect Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Mô hình cảnh giác tự nhiên, rón rén tiếp cận và vung vợt theo quỹ đạo 3D" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleInsect" Click="BtnToggleInsect_Click" Content="▶ BẮT ĐẦU BẮT BỌ" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="16,8" BorderThickness="0" Margin="0,0,12,0"/>
                                <TextBlock Text="Bọ đã bắt: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBugsCaught" Text="0" Foreground="#38BDF8" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 5. EXCAVATION PANEL ================= -->
                <Grid x:Name="PanelExcavation" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🏺 Tự động Đào cổ vật (Excavation Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Định vị kim tự tháp, nhân sư, rương báu sa mạc và đào tự động" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleExcavation" Click="BtnToggleExcavation_Click" Content="▶ BẮT ĐẦU ĐÀO" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Padding="16,8" BorderThickness="0" Margin="0,0,12,0"/>
                                <TextBlock Text="Cổ vật hoàn thành: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRelicsDug" Text="0" Foreground="#4ADE80" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 6. FARM PANEL ================= -->
                <Grid x:Name="PanelFarm" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🌱 Tự động Nông trại (Farm Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Tự động thu hoạch mùa màng, tưới nước và gieo hạt theo lu kỳ" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16"/>
                            <Button Content="▶ BẮT ĐẦU CHU KỲ NÔNG TRẠI" Background="#059669" Foreground="White" FontWeight="Bold" Width="220" HorizontalAlignment="Left" Padding="14,8" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 7. COLLECT PANEL ================= -->
                <Grid x:Name="PanelCollect" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="📦 Tự động Nhặt vật phẩm sân (Collect Bot)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Quét các vật thể rơi trên mặt đất và nhặt tự động qua OnPickFieldObject()" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16"/>
