                <!-- ================= 9. SETTINGS PANEL ================= -->
                <Grid x:Name="PanelSettings" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
