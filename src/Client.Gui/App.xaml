<Application x:Class="DTA.Client.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#0284C7"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4ADE80"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FBBF24"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F87171"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
    </Application.Resources>
</Application>
