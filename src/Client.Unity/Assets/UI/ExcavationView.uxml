<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Styles/DTA_ModernTheme.uss" />
    <ui:ScrollView style="flex-grow: 1;">
        <!-- Status Card -->
        <ui:VisualElement class="card">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="🏺 Tự động Đào cổ vật (Excavation Bot)" class="card-title" style="margin-bottom: 0;" />
                <ui:Label text="TRẠNG THÁI: SẴN SÀNG" class="status-badge" />
            </ui:VisualElement>
            <ui:Label text="Tự động phát hiện hòm cổ vật, kim tự tháp, nhân sư và kích hoạt đào" style="color: #94a3b8; font-size: 13px; margin-top: 4px;" />
            
            <ui:VisualElement style="flex-direction: row; margin-top: 16px;">
                <ui:Button name="btn_start_excavation" text="▶ BẮT ĐẦU ĐÀO" class="btn-primary" style="margin-right: 12px; height: 42px;" />
                <ui:Button name="btn_stop_excavation" text="⏹ DỪNG LẠI" class="btn-secondary" style="height: 42px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Options Card -->
        <ui:VisualElement class="card">
            <ui:Label text="Danh mục cổ vật ưu tiên" class="card-title" />
            <ui:Toggle label="Kim tự tháp (Pyramid - 3000 HP)" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Nhân sư (Sphinx - 3000 HP)" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Mặt nạ Tutankhamen (3000 HP)" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Tượng Moai cổ (3000 HP)" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Rương báu sa mạc (Chest Desert - 1000 HP)" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Tự sửa xẻng đào khi hết độ bền" value="true" style="margin-bottom: 8px;" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
