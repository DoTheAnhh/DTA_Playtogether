/* DTA_Playtogether - Modern Dark Graphite Design System USS */

:root {
    --bg-dark: #0f172a;
    --card-bg: #1e293b;
    --card-hover: #334155;
    --border-color: #334155;
    --primary: #38bdf8;
    --primary-hover: #0284c7;
    --success: #4ade80;
    --warning: #fbbf24;
    --danger: #f87171;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
}

.app-container {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
}

/* TopBar */
.top-bar {
    height: 48px;
    background-color: #1e293b;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
}

.brand-title {
    color: var(--primary);
    font-size: 16px;
    -unity-font-style: bold;
}

.status-badge {
    background-color: #064e3b;
    color: var(--success);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 999px;
    font-size: 12px;
}

/* Sidebar */
.sidebar {
    width: 220px;
    background-color: #0f172a;
    border-right-width: 1px;
    border-right-color: var(--border-color);
    padding: 12px;
}

.nav-button {
    height: 40px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: transparent;
    color: var(--text-secondary);
    border-width: 0;
    align-items: flex-start;
    padding-left: 12px;
    justify-content: center;
    font-size: 14px;
}

.nav-button:hover {
    background-color: var(--card-hover);
    color: var(--text-primary);
}

.nav-button-active {
    background-color: #0284c7;
    color: #ffffff;
    -unity-font-style: bold;
}

/* Content Area */
.content-area {
    flex-grow: 1;
    padding: 20px;
    background-color: var(--bg-dark);
}

.card {
    background-color: var(--card-bg);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--border-color);
    padding: 16px;
    margin-bottom: 16px;
}

.card-title {
    color: var(--text-primary);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* Teleport Table */
.tele-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
}

.tele-row:hover {
    background-color: var(--card-hover);
    border-radius: 6px;
}

.btn-primary {
    background-color: var(--primary);
    color: #0f172a;
    border-radius: 8px;
    padding: 8px 16px;
    border-width: 0;
    -unity-font-style: bold;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
    color: #ffffff;
}

.btn-secondary {
    background-color: var(--card-hover);
    color: var(--text-primary);
    border-radius: 8px;
    padding: 8px 16px;
    border-width: 1px;
    border-color: var(--border-color);
}
