<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Styles/DTA_ModernTheme.uss" />
    <ui:ScrollView style="flex-grow: 1;">
        <!-- Status Card -->
        <ui:VisualElement class="card">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="🦋 Tự động Bắt bọ (Insect Bot)" class="card-title" style="margin-bottom: 0;" />
                <ui:Label text="TRẠNG THÁI: SẴN SÀNG" class="status-badge" />
            </ui:VisualElement>
            <ui:Label text="Mô hình cảnh giác InsectMoveSetting, dự đoán toạ độ và gọi OnClickInsectCollecting" style="color: #94a3b8; font-size: 13px; margin-top: 4px;" />
            
            <ui:VisualElement style="flex-direction: row; margin-top: 16px;">
                <ui:Button name="btn_start_insect" text="▶ BẮT ĐẦU BẮT BỌ" class="btn-primary" style="margin-right: 12px; height: 42px;" />
                <ui:Button name="btn_stop_insect" text="⏹ DỪNG LẠI" class="btn-secondary" style="height: 42px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Options Card -->
        <ui:VisualElement class="card">
            <ui:Label text="Cấu hình Bắt bọ & Tiếp cận" class="card-title" />
            
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <ui:Label text="Cấp sao mục tiêu:" style="color: #f8fafc;" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Button text="1⭐" class="btn-secondary" style="margin-right: 4px;" />
                    <ui:Button text="2⭐" class="btn-secondary" style="margin-right: 4px;" />
                    <ui:Button text="3⭐" class="btn-primary" style="margin-right: 4px;" />
                    <ui:Button text="4⭐" class="btn-primary" style="margin-right: 4px;" />
                    <ui:Button text="5⭐" class="btn-primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Toggle label="Tự sửa vợt khi hỏng" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Tự động rón rén khi vào vùng cảnh giác của bọ" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Dự đoán quỹ đạo bay của bọ (Trajectory Prediction)" value="true" style="margin-bottom: 8px;" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
