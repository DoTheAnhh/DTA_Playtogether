<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Styles/DTA_ModernTheme.uss" />
    <ui:ScrollView style="flex-grow: 1;">
        <!-- Status Card -->
        <ui:VisualElement class="card">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="🎣 Tự động Câu cá (Fishing Bot)" class="card-title" style="margin-bottom: 0;" />
                <ui:Label text="TRẠNG THÁI: SẴN SÀNG" class="status-badge" />
            </ui:VisualElement>
            <ui:Label text="Thực thi trực tiếp qua Game Functions trên Unity Main Thread, không chạm màn hình" style="color: #94a3b8; font-size: 13px; margin-top: 4px;" />
            
            <ui:VisualElement style="flex-direction: row; margin-top: 16px;">
                <ui:Button name="btn_start_fishing" text="▶ BẮT ĐẦU CÂU" class="btn-primary" style="margin-right: 12px; height: 42px; font-size: 14px;" />
                <ui:Button name="btn_stop_fishing" text="⏹ DỪNG LẠI" class="btn-secondary" style="height: 42px; font-size: 14px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Options Card -->
        <ui:VisualElement class="card">
            <ui:Label text="Tùy chọn & Bộ lọc nâng cao" class="card-title" />
            
            <!-- Action Mode -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <ui:Label text="Xử lý cá sau khi câu:" style="color: #f8fafc; font-size: 14px;" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Button text="Bảo quản (Keep)" class="btn-primary" style="margin-right: 8px;" />
                    <ui:Button text="Bán nhanh (Sell)" class="btn-secondary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Toggles -->
            <ui:Toggle label="Tự sửa cần khi hết độ bền" value="true" style="margin-bottom: 8px;" />
            <ui:Toggle label="Cá cắn nhanh (Fast Bite / Bỏ qua nhấp mồi)" value="false" style="margin-bottom: 8px;" />
            <ui:Toggle label="Khóa góc nhìn camera khi câu (Lock POV)" value="false" style="margin-bottom: 8px;" />
            <ui:Toggle label="Bật bộ lọc cá theo bóng & nền" value="true" style="margin-bottom: 8px;" />

            <!-- Filter Badges -->
            <ui:Label text="Cỡ bóng muốn câu (1..7):" style="color: #94a3b8; font-size: 12px; margin-top: 8px;" />
            <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                <ui:Button text="Bóng 1" class="btn-secondary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 2" class="btn-secondary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 3" class="btn-secondary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 4" class="btn-primary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 5" class="btn-primary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 6" class="btn-primary" style="margin-right: 4px;" />
                <ui:Button text="Bóng 7" class="btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Stats Card -->
        <ui:VisualElement class="card">
            <ui:Label text="Thống kê phiên làm việc" class="card-title" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-around;">
                <ui:VisualElement style="align-items: center;">
                    <ui:Label text="Đã câu được" style="color: #94a3b8; font-size: 12px;" />
                    <ui:Label text="142" style="color: #38bdf8; font-size: 24px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: center;">
                    <ui:Label text="Đã bán nhanh" style="color: #94a3b8; font-size: 12px;" />
                    <ui:Label text="118" style="color: #4ade80; font-size: 24px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: center;">
                    <ui:Label text="Độ bền cần" style="color: #94a3b8; font-size: 12px;" />
                    <ui:Label text="86%" style="color: #fbbf24; font-size: 24px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
