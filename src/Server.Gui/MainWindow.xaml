<Window x:Class="DTA.Server.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTA Play Together — Server Manager"
        Height="560" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="SRV" Foreground="Black" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DTA SERVER HOST" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ASP.NET Core Kestrel" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PORT 5000: RUNNING" Foreground="#4ADE80" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cards Grid -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cổng kết nối API" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock Text="http://localhost:5000" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="14" Margin="0,4,0,8"/>
                        <Button x:Name="BtnOpenSwagger" Click="BtnOpenSwagger_Click" Content="🌐 Mở Swagger UI" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="SemiBold" Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Điểm Teleport Master" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock x:Name="TxtTeleCount" Text="5 vị trí chuẩn" Foreground="{StaticResource SuccessColor}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock Text="Bao gồm góc nhìn nhân vật &amp; POV" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Xác thực Bản quyền" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock Text="RSA-256 HMAC Active" Foreground="{StaticResource WarningColor}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock Text="Dynamic UI Schema Server-Driven" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Server Activity Log -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nhật ký hoạt động máy chủ (Live Server Logs):" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <ListBox x:Name="ListLogs" Grid.Row="1" Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" Padding="8"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Máy chủ đang chạy ngầm độc lập. Không mở cửa sổ dòng lệnh." Foreground="#64748B" FontSize="11"/>
                <TextBlock Text="DTA Server Runtime v2.0" Foreground="#475569" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
